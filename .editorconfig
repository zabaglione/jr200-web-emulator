root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[Makefile]
indent_style = tab

[*.{yml,yaml,json}]
indent_style = space
indent_size = 2

[LICENSES/VJR200.txt]
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = false
